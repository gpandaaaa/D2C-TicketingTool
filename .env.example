# Local development only. Replace database password before starting.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_PORT=3000
# Explicit development seed only; not used during normal startup.
SEED_PASSWORD=D2C-Local-Only-2026!
